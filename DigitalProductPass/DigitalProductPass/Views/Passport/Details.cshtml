@model ProductItem
@{
    var p = Model.Product;
    ViewData["Title"] = p.Name;
    var recycled = p.Materials.Where(m => m.IsRecycled).Sum(m => m.Percentage);
}

<div class="passport mx-auto">
    <div class="card shadow-sm mb-3">
        @if (!string.IsNullOrWhiteSpace(p.ImageUrl))
        {
            <img src="@p.ImageUrl" class="card-img-top passport-img" alt="@p.Name" />
        }
        <div class="card-body">
            <div class="text-muted small">@p.Brand.Name</div>
            <h1 class="h3 mb-1">@p.Name</h1>
            @if (!string.IsNullOrWhiteSpace(p.Description))
            {
                <p class="mb-2">@p.Description</p>
            }
            <div class="d-flex flex-wrap gap-2">
                <span class="badge text-bg-light border">Код: @Model.SerialCode</span>
                @if (!string.IsNullOrWhiteSpace(Model.Size)) { <span class="badge text-bg-light border">Размер: @Model.Size</span> }
                @if (!string.IsNullOrWhiteSpace(Model.Color)) { <span class="badge text-bg-light border">Цвят: @Model.Color</span> }
                <span class="badge text-bg-light border">Произведено: @Model.ProducedOn.ToString("dd.MM.yyyy")</span>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        @if (p.CarbonFootprintKg is decimal co2)
        {
            <div class="col-6">
                <div class="stat-tile">
                    <div class="stat-value">@co2.ToString("0.#") kg</div>
                    <div class="stat-label">CO₂e въглероден отпечатък</div>
                </div>
            </div>
        }
        <div class="col-6">
            <div class="stat-tile">
                <div class="stat-value">@recycled.ToString("0.#")%</div>
                <div class="stat-label">рециклирани материали</div>
            </div>
        </div>
    </div>

    @if (p.Materials.Any())
    {
        <div class="card mb-3">
            <div class="card-body">
                <h2 class="h5">Състав</h2>
                <ul class="list-group list-group-flush">
                    @foreach (var m in p.Materials.OrderByDescending(m => m.Percentage))
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-start px-0">
                            <div>
                                @m.Name
                                @if (m.IsRecycled) { <span class="badge text-bg-success ms-1">рециклиран</span> }
                                @if (!string.IsNullOrWhiteSpace(m.Origin)) { <div class="text-muted small">Произход: @m.Origin</div> }
                            </div>
                            <strong>@m.Percentage.ToString("0.##")%</strong>
                        </li>
                    }
                </ul>
            </div>
        </div>
    }

    @if (p.SupplyChainSteps.Any())
    {
        <div class="card mb-3">
            <div class="card-body">
                <h2 class="h5">Верига на доставки</h2>
                <ol class="timeline">
                    @foreach (var s in p.SupplyChainSteps.OrderBy(s => s.Order))
                    {
                        <li>
                            <div class="fw-semibold">@s.Stage.Label()</div>
                            <div>@s.FacilityName, @s.Country</div>
                            @if (s.Date is DateOnly d) { <div class="text-muted small">@d.ToString("dd.MM.yyyy")</div> }
                        </li>
                    }
                </ol>
            </div>
        </div>
    }

    @if (p.Certificates.Any())
    {
        <div class="card mb-3">
            <div class="card-body">
                <h2 class="h5">Сертификати</h2>
                @foreach (var c in p.Certificates)
                {
                    <div class="d-flex justify-content-between border-bottom py-2">
                        <div>
                            <div class="fw-semibold">@c.Name</div>
                            @if (!string.IsNullOrWhiteSpace(c.Issuer)) { <div class="text-muted small">@c.Issuer</div> }
                        </div>
                        <div class="text-end small text-muted">
                            @if (c.ValidUntil is DateOnly v) { <div>до @v.ToString("dd.MM.yyyy")</div> }
                            @if (!string.IsNullOrWhiteSpace(c.DocumentUrl)) { <a href="@c.DocumentUrl" target="_blank" rel="noopener">PDF</a> }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(p.CareInstructions) || !string.IsNullOrWhiteSpace(p.RecyclingInstructions))
    {
        <div class="card mb-3">
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(p.CareInstructions))
                {
                    <h2 class="h5">Грижа</h2>
                    <p>@p.CareInstructions</p>
                }
                @if (!string.IsNullOrWhiteSpace(p.RecyclingInstructions))
                {
                    <h2 class="h5">Рециклиране</h2>
                    <p class="mb-0">@p.RecyclingInstructions</p>
                }
            </div>
        </div>
    }
</div>
