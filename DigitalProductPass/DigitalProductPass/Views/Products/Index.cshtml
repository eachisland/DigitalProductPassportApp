@model List<Product>
@{
    ViewData["Title"] = "Продукти";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Продукти</h1>
    <a class="btn btn-success" asp-action="Create">+ Нов продукт</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table mb-0 align-middle">
            <thead><tr><th>Име</th><th>Марка</th><th>SKU</th><th>Артикули</th><th></th></tr></thead>
            <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Name</td>
                    <td>@p.Brand.Name</td>
                    <td>@p.Sku</td>
                    <td>@p.Items.Count</td>
                    <td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@p.Id">Управление</a></td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="5" class="text-muted">Още няма продукти.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
