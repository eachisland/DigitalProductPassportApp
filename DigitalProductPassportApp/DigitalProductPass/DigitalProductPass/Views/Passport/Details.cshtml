@model ProductItem
@inject PassportLinkService Links
@{
    var p = Model.Product;
    ViewData["Title"] = p.Name;

    var carbon = CarbonCalculator.Compute(p);
    var mats = p.Materials.OrderByDescending(m => m.Percentage).ToList();
    var recycled = p.Materials.Where(m => m.IsRecycled).Sum(m => m.Percentage);
    var steps = p.SupplyChainSteps.OrderBy(s => s.Order).ToList();

    var wash = !string.IsNullOrWhiteSpace(p.WashInstructions) ? p.WashInstructions : p.CareInstructions;
    var eol = !string.IsNullOrWhiteSpace(p.EndOfLifeGuidance) ? p.EndOfLifeGuidance : p.RecyclingInstructions;

    var gs1 = Links.Gs1DigitalLink(Model);
    var shareLink = gs1 ?? Links.Resolver(Model.PublicId);

    var recyclScore = p.RecyclabilityScore ?? 0;
    var repairPct = (int)Math.Round((double)(p.RepairabilityIndex ?? 0m) * 10);
}

<div class="passport mx-auto">

    @if (Model.IsRevoked)
    {
        <div class="revoked-banner mb-3" role="alert">
            <div class="font-display h5 mb-1">@T["pp.revoked.title"]</div>
            <div>@T["pp.revoked.text"]</div>
        </div>
    }

    <!-- Hero -->
    <div class="card passport-hero shadow-sm mb-4">
        @if (!string.IsNullOrWhiteSpace(p.ImageUrl))
        {
            <img src="@p.ImageUrl" class="passport-img" alt="@p.Name" />
        }
        <div class="card-body">
            <div class="eyebrow mb-2">@p.Brand.Name</div>
            <h1 class="passport-title mb-2">@p.Name</h1>
            @if (!string.IsNullOrWhiteSpace(p.Description))
            {
                <p class="mb-3">@p.Description</p>
            }
            <div class="d-flex flex-wrap gap-2 mb-3">
                <span class="badge text-bg-light">@T["pp.serial"]: @Model.SerialCode</span>
                @if (!string.IsNullOrWhiteSpace(Model.Color)) { <span class="badge text-bg-light">@T["pp.color"]: @Model.Color</span> }
                @if (!string.IsNullOrWhiteSpace(Model.Size)) { <span class="badge text-bg-light">@T["pp.size"]: @Model.Size</span> }
                @if (!string.IsNullOrWhiteSpace(Model.BatchNumber)) { <span class="badge text-bg-light">@T["pp.batch"]: @Model.BatchNumber</span> }
                <span class="badge text-bg-light">@T["pp.produced"]: @Model.ProducedOn.ToString("dd.MM.yyyy")</span>
            </div>
            <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#qrModal">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="me-1" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M14 14h3v3h-3zM20 14v.01M14 20v.01M17 20h4v-3"/></svg>
                @T["pp.showQr"]
            </button>
        </div>
    </div>

    <!-- Environmental impact -->
    <h2 class="h4 mb-3">@T["pp.impact"]</h2>
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4">
            <div class="stat-tile">
                <div class="stat-label">@T["pp.carbon"]</div>
                @if (carbon.HeadlineKg is decimal co2)
                {
                    <div class="stat-value">@co2.ToString("0.##")<span class="stat-unit">@T["pp.carbon.unit"]</span></div>
                    <div class="stat-sub">@(carbon.IsCalculated ? T["pp.carbon.calc"] : T["pp.carbon.declared"])</div>
                    @if (carbon.IsCalculated && carbon.DeclaredKg is decimal life)
                    {
                        <div class="stat-sub">@T.F("pp.carbon.life", life.ToString("0.##"))</div>
                    }
                }
                else
                {
                    <div class="stat-value text-muted">—</div>
                    <div class="stat-sub">@T["common.na"]</div>
                }
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="stat-tile">
                <div class="stat-label">@T["pp.water"]</div>
                @if (p.WaterUsageLiters is decimal water)
                {
                    <div class="stat-value">@water.ToString("N0")<span class="stat-unit">@T["pp.water.unit"]</span></div>
                }
                else
                {
                    <div class="stat-value text-muted">—</div>
                    <div class="stat-sub">@T["common.na"]</div>
                }
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="stat-tile">
                <div class="stat-label">@T["pp.recycled"]</div>
                <div class="stat-value">@recycled.ToString("0.#")<span class="stat-unit">%</span></div>
                <div class="meter" role="presentation"><span style="width:@(Math.Min(100, (int)Math.Round(recycled)))%"></span></div>
            </div>
        </div>
        <div class="col-12 col-md-6">
            <div class="stat-tile d-flex align-items-center gap-3">
                @if (p.RecyclabilityScore.HasValue)
                {
                    <div class="ring" style="--val:@recyclScore"><span>@recyclScore</span></div>
                }
                <div>
                    <div class="stat-label mb-1">@T["pp.recycl"]</div>
                    @if (p.RecyclabilityScore.HasValue) { <div class="stat-sub mt-0">@T["pp.of100"]</div> }
                    else { <div class="stat-value text-muted">—</div><div class="stat-sub">@T["common.na"]</div> }
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6">
            <div class="stat-tile">
                <div class="stat-label">@T["pp.repair"]</div>
                @if (p.RepairabilityIndex is decimal repair)
                {
                    <div class="stat-value">@repair.ToString("0.#")<span class="stat-unit">@T["pp.of10"]</span></div>
                    <div class="meter" role="presentation"><span style="width:@(Math.Min(100, repairPct))%"></span></div>
                }
                else
                {
                    <div class="stat-value text-muted">—</div>
                    <div class="stat-sub">@T["common.na"]</div>
                }
            </div>
        </div>
    </div>

    <!-- Materials -->
    @if (mats.Any())
    {
        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h4 mb-3">@T["pp.materials"]</h2>

                <div class="mix-bar mb-3" role="img" aria-label="@T["pp.materials"]">
                    @for (var mi = 0; mi < mats.Count; mi++)
                    {
                        var w = Math.Min(100m, mats[mi].Percentage).ToString("0.##", CultureInfo.InvariantCulture);
                        <span class="mix-@(mi % 6)" style="width:@(w)%" title="@mats[mi].Name"></span>
                    }
                </div>

                <ul class="list-group list-group-flush">
                    @for (var mi = 0; mi < mats.Count; mi++)
                    {
                        var m = mats[mi];
                        <li class="list-group-item d-flex justify-content-between align-items-start gap-3 px-0">
                            <div class="d-flex">
                                <span class="mix-dot mix-@(mi % 6) mt-1"></span>
                                <div>
                                    <div class="fw-semibold">
                                        @m.Name
                                        @if (m.IsRecycled) { <span class="badge badge-lime ms-1">@T["pp.recycledTag"]</span> }
                                    </div>
                                    <div class="text-muted small">
                                        @if (!string.IsNullOrWhiteSpace(m.Origin)) { <span>@T["pp.origin"]: @m.Origin</span> }
                                        @if (m.CarbonIndexKgPerKg is decimal ci)
                                        {
                                            <span>@(string.IsNullOrWhiteSpace(m.Origin) ? "" : " · ")@T.F("pp.index", ci.ToString("0.###"))</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(m.CertificateCode))
                                    {
                                        <span class="cert-chip mt-1">@T["pp.certCode"] · @m.CertificateCode</span>
                                    }
                                </div>
                            </div>
                            <strong class="font-display fs-5">@m.Percentage.ToString("0.##")%</strong>
                        </li>
                    }
                </ul>

                @if (carbon.IndexKgPerKg is decimal idx)
                {
                    <div class="callout mt-3">
                        <div><strong>@T["pp.weighted"]:</strong> @T.F("pp.index", idx.ToString("0.###"))</div>
                        <div class="text-muted">@T["pp.weightedNote"]</div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Supply chain -->
    @if (steps.Any())
    {
        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h4 mb-3">@T["pp.chain"]</h2>
                <ol class="timeline mb-0">
                    @foreach (var s in steps)
                    {
                        <li>
                            <div class="fw-semibold">@s.Stage.Label(T)</div>
                            <div>@s.FacilityName, @s.Country</div>
                            @if (s.Date is DateOnly d) { <div class="text-muted small">@d.ToString("dd.MM.yyyy")</div> }
                        </li>
                    }
                </ol>
            </div>
        </div>
    }

    <!-- Care & end of life -->
    @if (!string.IsNullOrWhiteSpace(wash) || !string.IsNullOrWhiteSpace(eol))
    {
        <div class="row g-3 mb-4">
            @if (!string.IsNullOrWhiteSpace(wash))
            {
                <div class="col-md-6">
                    <div class="card h-100"><div class="card-body">
                        <h2 class="h5">@T["pp.care"]</h2>
                        <p class="mb-0">@wash</p>
                    </div></div>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(eol))
            {
                <div class="col-md-6">
                    <div class="card h-100"><div class="card-body">
                        <h2 class="h5">@T["pp.eol"]</h2>
                        <p class="mb-0">@eol</p>
                    </div></div>
                </div>
            }
        </div>
    }

    <!-- Certificates -->
    @if (p.Certificates.Any())
    {
        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h4 mb-3">@T["pp.certs"]</h2>
                @foreach (var c in p.Certificates)
                {
                    <div class="d-flex justify-content-between border-bottom py-2">
                        <div>
                            <div class="fw-semibold">@c.Name</div>
                            @if (!string.IsNullOrWhiteSpace(c.Issuer)) { <div class="text-muted small">@c.Issuer</div> }
                        </div>
                        <div class="text-end small text-muted">
                            @if (c.ValidUntil is DateOnly v) { <div>@T.F("pp.until", v.ToString("dd.MM.yyyy"))</div> }
                            @if (!string.IsNullOrWhiteSpace(c.DocumentUrl)) { <a href="@c.DocumentUrl" target="_blank" rel="noopener">PDF</a> }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- Full-screen QR modal -->
<div class="modal fade qr-modal" id="qrModal" tabindex="-1" aria-labelledby="qrTitle" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h2 class="modal-title h5" id="qrTitle">@T["pp.qr.title"]</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["common.close"]"></button>
            </div>
            <div class="modal-body">
                <div class="qr-stage">
                    <div class="qr-frame mb-3">
                        <img src="/qr/@(Model.PublicId).svg" alt="QR @Model.SerialCode" />
                    </div>
                    <div class="font-display h4 mb-1">@p.Name</div>
                    <div class="mb-4 text-muted"><code>@Model.SerialCode</code></div>

                    <label for="qrLink" class="form-label d-block text-start">@(gs1 is null ? T["pp.qr.plain"] : T["pp.qr.gs1"])</label>
                    <div class="input-group mb-2">
                        <input id="qrLink" class="form-control qr-link" readonly value="@shareLink" onfocus="this.select()" />
                        <button type="button" class="btn btn-success" data-copy-target="#qrLink" data-copied="@T["pp.qr.copied"]">
                            <span data-copy-label>@T["pp.qr.copy"]</span>
                        </button>
                    </div>
                    @if (gs1 is null)
                    {
                        <p class="small text-muted text-start mb-2">@T["pp.qr.noGtin"]</p>
                    }
                    <p class="small text-muted mb-3">@T["pp.qr.hint"]</p>
                    <div class="d-flex gap-3 justify-content-center small">
                        <a href="/qr/@(Model.PublicId).svg" download="@(Model.SerialCode).svg">@T["pp.qr.download"] SVG</a>
                        <a href="/qr/@(Model.PublicId).png" download="@(Model.SerialCode).png">@T["pp.qr.download"] PNG</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
