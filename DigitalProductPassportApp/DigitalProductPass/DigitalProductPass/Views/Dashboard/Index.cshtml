@using DigitalProductPass.ViewModels
@model DashboardViewModel
@{
    ViewData["Title"] = T["dash.title"];
}

<h1 class="h2 mb-4">@T["dash.title"]</h1>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3"><div class="stat-tile"><div class="stat-value">@Model.Products</div><div class="stat-label">@T["dash.products"]</div></div></div>
    <div class="col-6 col-lg-3"><div class="stat-tile"><div class="stat-value">@Model.Items</div><div class="stat-label">@T["dash.items"]</div></div></div>
    <div class="col-6 col-lg-3"><div class="stat-tile"><div class="stat-value">@Model.TotalScans</div><div class="stat-label">@T["dash.total"]</div></div></div>
    <div class="col-6 col-lg-3"><div class="stat-tile"><div class="stat-value">@Model.ScansToday</div><div class="stat-label">@T["dash.today"]</div></div></div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <h2 class="h5">@T["dash.chart"]</h2>
                <canvas id="scansChart" height="110"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5">@T["dash.top"]</h2>
                @if (!Model.TopProducts.Any())
                {
                    <p class="text-muted mb-0">@T["dash.none"]</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var t in Model.TopProducts)
                        {
                            <li class="list-group-item d-flex justify-content-between px-0">
                                <span>@t.Name</span><strong>@t.Scans</strong>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>

<div class="card mt-4">
    <div class="card-body">
        <h2 class="h5">@T["dash.recent"]</h2>
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead><tr><th>@T["dash.time"]</th><th>@T["dash.product"]</th><th>@T["dash.code"]</th></tr></thead>
                <tbody>
                @foreach (var r in Model.RecentScans)
                {
                    <tr><td>@r.ScannedAt.ToString("dd.MM.yyyy HH:mm")</td><td>@r.ProductName</td><td>@r.SerialCode</td></tr>
                }
                @if (!Model.RecentScans.Any())
                {
                    <tr><td colspan="3" class="text-muted">@T["dash.none"]</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script>
        new Chart(document.getElementById('scansChart'), {
            type: 'bar',
            data: {
                labels: @Json.Serialize(Model.DayLabels),
                datasets: [{ label: @Json.Serialize(T["dash.series"]), data: @Json.Serialize(Model.DayCounts), backgroundColor: getComputedStyle(document.documentElement).getPropertyValue('--forest-500').trim() || '#35664d' }]
            },
            options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
        });
    </script>
}
