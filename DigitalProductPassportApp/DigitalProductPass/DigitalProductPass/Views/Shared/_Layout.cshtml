@{
    var isOwner = User.IsInRole("StoreOwner");
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
    string LangLink(string code) => Url.Action("Set", "Lang", new { culture = code, returnUrl = currentUrl })!;
}
<!DOCTYPE html>
<html lang="@T.Lang" data-theme="light" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] - @T["brand.title"]</title>

    <script>
        // Apply the saved (or system) theme before first paint to avoid a flash.
        (function () {
            try {
                var saved = localStorage.getItem('dpp-theme');
                var dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
                var t = dark ? 'dark' : 'light';
                document.documentElement.setAttribute('data-theme', t);
                document.documentElement.setAttribute('data-bs-theme', t);
            } catch (e) { }
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DigitalProductPass.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="dpp-nav">
        <nav class="navbar navbar-expand-md navbar-dark">
            <div class="container">
                <a class="navbar-brand dpp-brand" asp-controller="Home" asp-action="Index">
                    <span class="dpp-brand-mark" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19c0-8 5-13 14-14 0 9-5 14-13 14"/><path d="M5 19c3-5 6-8 10-10"/></svg>
                    </span>
                    <span>@T["brand.title"]</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Scan" asp-action="Index">@T["nav.scan"]</a></li>
                        @if (isOwner)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Products" asp-action="Index">@T["nav.products"]</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">@T["nav.dashboard"]</a></li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <div class="dropdown">
                            <button class="btn btn-nav dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@T["lang.label"]">
                                @T.Lang.ToUpperInvariant()
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item @(T.Lang == "en" ? "active" : "")" href="@LangLink("en")">English</a></li>
                                <li><a class="dropdown-item @(T.Lang == "tr" ? "active" : "")" href="@LangLink("tr")">Türkçe</a></li>
                                <li><a class="dropdown-item @(T.Lang == "de" ? "active" : "")" href="@LangLink("de")">Deutsch</a></li>
                            </ul>
                        </div>
                        <button type="button" class="btn btn-nav" id="themeToggle" title="@T["theme.toggle"]" aria-label="@T["theme.toggle"]">
                            <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
                            <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                        </button>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form method="post" asp-controller="Account" asp-action="Logout" class="m-0">
                                <button type="submit" class="btn btn-nav">@T["nav.logout"] <span class="opacity-75">· @(User.Identity?.Name)</span></button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-lime btn-sm" asp-controller="Account" asp-action="Login">@T["nav.login"]</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="py-4 py-md-5">
            @if (TempData["Success"] is string ok)
            {
                <div class="alert alert-success">@ok</div>
            }
            @if (TempData["Error"] is string err)
            {
                <div class="alert alert-danger">@err</div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="dpp-footer">
        <div class="container">
            <span class="font-display">@T["brand.title"]</span>
            <span class="text-muted-dpp">· @T["footer.text"] · &copy; 2026</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
